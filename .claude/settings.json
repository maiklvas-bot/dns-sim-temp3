{
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/script/scheme-audit.mjs\" --hook",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "powershell.exe -Command \"[Console]::Beep(880,300)\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -Command \"[Console]::Beep(440,200)\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rev-parse*)",
      "Bash(git fetch*)",
      "Bash(git push origin claude/*)",
      "Bash(npm run *)",
      "Bash(npx tsx *)",
      "Bash(npx tsc*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(node script/*)",
      "Bash(node --check *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(Remove-Item *)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(*curl* export *)",
      "Bash(cat .env)",
      "Bash(cat .env.local)",
      "Bash(*wget* $*)",
      "Bash(chmod 777 *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * dev*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.mcp.json)",
      "Read(./data.db)",
      "Read(./live-sessions.json)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.prod)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git push *:dev*)",
      "Bash(git push *+*)",
      "Bash(git push * :*)",
      "Bash(git push --delete*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)"
    ]
  }
}
