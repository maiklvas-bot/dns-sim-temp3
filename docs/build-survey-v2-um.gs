/**
 * Опрос УМ v2 — «Как управляющие оценивают готовность подчинённых» (20 вопросов).
 * Создаёт Google-форму со всей анкетой (docs/simulation-survey-v2-um.md).
 *
 * КАК ЗАПУСТИТЬ:
 * 1. Открой https://script.google.com → New project.
 * 2. Удали содержимое Code.gs, вставь весь этот файл.
 * 3. Нажми Run (функция buildSurveyV2). Разреши доступ, когда попросит.
 * 4. Открой View → Logs (Ctrl+Enter). Там две ссылки:
 *    - EDIT — редактировать форму;
 *    - LIVE — та, что рассылаешь управляющим.
 */
function buildSurveyV2() {
  var form = FormApp.create('Оценка готовности начинающих руководителей — опрос УМ')
    .setDescription(
      'Мы настраиваем инструмент оценки по вашим меркам. Вопросы — о том, как вы на практике ' +
      'оцениваете готовность начинающих ЗУМ / ИО ЗУМ / старших продавцов (выпускников «Космонавтики»). ' +
      'Просьба писать конкретные действия — что человек ДЕЛАЛ, без общих оценок. Анонимно, ~15–20 минут.'
    )
    .setProgressBar(true)
    .setCollectEmail(false);

  var COMPS = [
    '1. Основы менеджмента',
    '2. Бизнес-процессы',
    '3. Финансовые показатели филиала',
    '4. Задачи сотрудников магазина',
    '5. Идеология Компании',
    '6. Организация и контроль работы',
    '7. Системность мышления',
    '8. Коммуникабельность',
    '9. Мотивация сотрудников',
    '10. Обучение сотрудников',
    '11. Объективная самооценка',
    '12. Гибкость поведения',
    '13. Личная мотивация к обучению и новым обязанностям',
    '14. Направленность на результат'
  ];
  var num = FormApp.createTextValidation().requireNumberBetween(0, 100).build();
  var exactly3 = FormApp.createCheckboxValidation().requireSelectExactly(3).build();

  function scale(title, help) {
    form.addScaleItem().setTitle(title).setHelpText(help || '1 — почти никогда, 5 — постоянно')
      .setBounds(1, 5).setLabels('почти никогда', 'постоянно').setRequired(true);
  }
  function para(title, help) {
    var it = form.addParagraphTextItem().setTitle(title).setRequired(true);
    if (help) it.setHelpText(help);
  }

  // ---- Блок 1. О вас ----
  form.addPageBreakItem().setTitle('1. О вас').setHelpText('Анонимно, для группировки ответов.');
  form.addMultipleChoiceItem().setTitle('Формат вашего магазина').setRequired(true)
    .setChoiceValues(['Гипер', 'Стандарт', 'Компакт', 'Другое']);
  form.addMultipleChoiceItem().setTitle('Сколько начинающих руководителей (ЗУМ / ИО ЗУМ / ст. продавцов) вы оценивали за последние 12 месяцев').setRequired(true)
    .setChoiceValues(['0', '1–2', '3–5', '6+']);

  // ---- Блок 2. Веса ----
  form.addPageBreakItem().setTitle('2. Что важнее при оценке готовности')
    .setHelpText('Сначала распределите вес между блоками, затем оцените важность внутри.');
  form.addTextItem().setTitle('Блок «Знания» — сколько баллов из 100').setRequired(true).setValidation(num);
  form.addTextItem().setTitle('Блок «Умения» — сколько баллов из 100').setRequired(true).setValidation(num);
  form.addTextItem().setTitle('Блок «Личностные качества» — сколько баллов из 100').setRequired(true).setValidation(num);
  form.addSectionHeaderItem().setTitle('Сумма трёх блоков должна равняться 100.');
  form.addGridItem().setTitle('Важность компетенций для готовности к роли (1 — второстепенно, 5 — критично)')
    .setRequired(true).setRows(COMPS).setColumns(['1', '2', '3', '4', '5']);
  form.addCheckboxItem().setTitle('Отметьте ровно 3 компетенции-СТОП-ФАКТОРА — без которых человека нельзя ставить на роль')
    .setRequired(true).setChoiceValues(COMPS).setValidation(exactly3);
  form.addMultipleChoiceItem().setTitle('Что перевешивает, когда оценка спорная?').setRequired(true)
    .setChoiceValues(['Объём знаний', 'Умение применять на практике', 'Ответственность и мотивация']);
  para('Коротко: почему именно это перевешивает?');

  // ---- Блок 3. Слабое поведение ----
  form.addPageBreakItem().setTitle('3. Где начинающие проваливаются чаще')
    .setHelpText('По каждой зоне: как часто видите провал, и одно конкретное действие «что не так».');
  scale('Коммуникация и конфликты с клиентами — как часто проваливает');
  para('Что именно делает не так в коммуникации/конфликте? (1 строка)');
  scale('Инициатива и самостоятельность (сообщает ли о проблеме, просит ли помощь, действует ли без подсказки) — как часто проваливает');
  para('Что именно делает не так с инициативой/самостоятельностью? (1 строка)');
  scale('Постановка задач подчинённым (сроки, ТЗ, делегирование) — как часто проваливает');
  para('Что именно делает не так при постановке задач? (1 строка)');
  scale('Планирование дня и приоритетов — как часто проваливает');
  para('Что именно делает не так с планированием? (1 строка)');
  scale('Контроль исполнения (процессы, отгрузки, товар, документы) — как часто проваливает');
  para('Что именно делает не так с контролем? (1 строка)');

  // ---- Блок 4. Сильное поведение ----
  form.addPageBreakItem().setTitle('4. Что отличает готового — сильное поведение')
    .setHelpText('Продолжите фразу конкретным наблюдаемым действием.');
  para('Сильный начинающий в конфликте с клиентом — это когда он… (продолжите конкретным действием)');
  para('Приведите случай за 6 мес, когда подчинённый решил проблему САМ, без вашей подсказки — что именно он сделал?');
  para('Я понимаю, что человек умеет ставить задачи, когда он… (продолжите)');
  para('Готовый к роли планирует так, что… (продолжите)');
  para('Приведите случай с ИЗМЕРИМЫМ улучшением, которого добился подчинённый (что было → что стало)');

  // ---- Блок 5. Реакция и доверие ----
  form.addPageBreakItem().setTitle('5. Ваша реакция и доверие');
  form.addMultipleChoiceItem().setTitle('Подчинённый принял быстрое, но рискованное решение ради результата. Ваша типичная реакция').setRequired(true)
    .setChoiceValues(['Разберу и поддержу, если риск был осознан', 'Укажу на риск и подстрахую', 'Жёстко пресеку']);
  para('Как это влияет на вашу оценку его готовности? (1 строка)');
  para('Что сильнее всего роняет ваше доверие к готовности сотрудника?');

  // ---- Блок 6. Итог ----
  form.addPageBreakItem().setTitle('6. Итог');
  para('Если бы перед назначением можно было проверить только ОДНО — что именно вы бы проверили?');
  para('Сравните двух (без имён): одного сотрудника, которого вы бы повысили, и одного пока не готового — чем именно в поведении они отличаются?');

  Logger.log('EDIT: ' + form.getEditUrl());
  Logger.log('LIVE: ' + form.getPublishedUrl());
}
